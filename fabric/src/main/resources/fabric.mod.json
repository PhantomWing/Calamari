{
  "schemaVersion": 1,
  "id": "calamari",
  "version": "${version}",
  "name": "Calamari",
  "description": "Squids and glow squids drop calamari, a vanilla-friendly seafood you can cook, trade, and eat.",
  "authors": [
    "PhantomWing"
  ],
  "contact": {
    "homepage": "https://github.com/PhantomWing/Calamari",
    "sources": "https://github.com/PhantomWing/Calamari",
    "issues": "https://github.com/PhantomWing/Calamari/issues"
  },
  "license": "MIT License",
  "icon": "assets/calamari/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.phantomwing.calamari.fabric.CalamariFabric"
    ]
  },
  "mixins": [
    "calamari.mixins.json"
  ],
  "accessWidener": "calamari.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_range}",
    "architectury": ">=${architectury_version}",
    "cloth-config": ">=${cloth_config_version}"
  }
}
